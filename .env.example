# The only variable a deploy has to set.
# Get one at https://cloud.reown.com, then add your domain to the project's
# allowed domains or the modal will refuse to open in production.
VITE_REOWN_PROJECT_ID=

# Public URL of the site, sent to the wallet as connection metadata.
# Defaults to https://harvestpad.org when unset.
VITE_SITE_URL=https://harvestpad.org

# Optional. The deployed HarvestPad factory. While this is empty the app runs
# and connects normally but refuses to build a transaction.
VITE_FACTORY_ADDRESS=

# Optional overrides. Robinhood Chain's parameters are fixed in src/lib/env.ts,
# so these are only needed to point a build at a different network.
# VITE_CHAIN_ID=4663
# VITE_CHAIN_NAME=Robinhood Chain
# VITE_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# VITE_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com
# VITE_CHAIN_CURRENCY_NAME=Ether
# VITE_CHAIN_CURRENCY_SYMBOL=ETH
# VITE_CHAIN_CURRENCY_DECIMALS=18
