# Reown (WalletConnect) project id, from https://cloud.reown.com
# Required. Without it the wallet modal cannot open.
VITE_REOWN_PROJECT_ID=

# The chain the protocol is deployed on.
# All four are required before any transaction can be built.
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
VITE_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Native currency of that chain.
VITE_CHAIN_CURRENCY_NAME=Ether
VITE_CHAIN_CURRENCY_SYMBOL=ETH
VITE_CHAIN_CURRENCY_DECIMALS=18

# Deployed HarvestPad factory. Leave empty until it exists; the app will
# refuse to build a transaction rather than send one into the void.
VITE_FACTORY_ADDRESS=

# Public URL of this site, used as the wallet connection metadata.
VITE_SITE_URL=http://localhost:5173
